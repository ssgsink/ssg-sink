{
  "manifest_version": 3,
  "name": "신세계싱크 검색 확인 연결",
  "version": "1.1.1",
  "permissions": [
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://search.naver.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ssg-sink.vercel.app/admin/search-rank/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "신세계싱크 검색 확인 v1.1.1"
  }
}